{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kmos-site",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"routes": [
		{ "pattern": "kmos.in/*", "zone_name": "kmos.in" },
		{ "pattern": "www.kmos.in/*", "zone_name": "kmos.in" }
	],
	// Do not put ADMIN_PASSWORD here. Set it with `wrangler secret put`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kmos-inquiries",
			"database_id": "096e4c58-e3b1-4c0d-b26c-8b443ae153f0"
		}
	]
}
