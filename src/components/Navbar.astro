---
// A link with `menu` renders as a dropdown trigger instead of a plain link.
interface NavLink {
    label: string;
    href?: string;
    menu?: { label: string; href: string }[];
}

const navLinks: NavLink[] = [
    { label: "Product", href: "/product"},
    { label: "Pricing", href: "/pricing" },
];
---

<header class="nav-wrap">
    <nav class="nav">
        <a class="brand" href="/">
            <img
                class="brand-mark"
                src="/kmos.png"
                alt="kmos"
                width="280"
                height="100"
            />
        </a>

        <div class="nav-links" id="nav-panel">
            {
                navLinks.map((link, i) =>
                    link.menu ? (
                        <div class="nav-item has-menu">
                            <button
                                class="nav-link nav-trigger"
                                type="button"
                                aria-expanded="false"
                                aria-controls={`nav-menu-${i}`}
                            >
                                {link.label}
                                <svg
                                    class="chev"
                                    viewBox="0 0 12 12"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M3 4.5L6 7.5L9 4.5"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </button>

                            <div class="nav-menu" id={`nav-menu-${i}`}>
                                {link.menu.map((entry) => (
                                    <a class="nav-menu-link" href={entry.href}>
                                        {entry.label}
                                    </a>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <a class="nav-link" href={link.href}>
                            {link.label}
                        </a>
                    ),
                )
            }
        </div>

        <div class="nav-actions">
            <button
                class="nav-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="nav-panel"
                aria-label="Open menu"
            >
                <span class="nav-toggle-bars" aria-hidden="true"></span>
            </button>
            <a class="btn btn-solid" href="/start">Start a project</a>
        </div>
    </nav>
</header>

<style>
    .nav-wrap {
        position: relative;
        z-index: 3;
        display: flex;
        justify-content: center;
        padding: 1.25rem 0 0;
    }

    .nav {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1.75rem;
        width: min(100%, 680px);
        padding: 0.5rem 0.5rem 0.5rem 1.1rem;
        border-radius: 999px;
        background: #fff;
        color: #14110f;
        border: 1px solid #e6e3df;
        box-shadow:
            0 1px 2px rgb(20 17 15 / 0.05),
            0 12px 28px -12px rgb(20 17 15 / 0.12);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        justify-self: start;
        color: inherit;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
    }

    .brand-mark {
        display: block;
        height: 1.7rem;
        width: auto;
        object-fit: contain;
    }

    .nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
        justify-self: center;
        gap: 1.1rem;
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.22rem;
        color: #5f5a55;
        text-decoration: none;
        font-size: 0.845rem;
        white-space: nowrap;
        transition: color 0.15s ease;
    }
    .nav-link:hover {
        color: #14110f;
    }

    .nav-item {
        position: relative;
        display: flex;
    }

    /* The trigger is a <button>, so strip the UA chrome to match .nav-link. */
    .nav-trigger {
        border: 0;
        padding: 0;
        background: none;
        font: inherit;
        font-size: 0.845rem;
        cursor: pointer;
    }

    .nav-item.open .nav-trigger {
        color: #14110f;
    }

    .chev {
        width: 0.7rem;
        height: 0.7rem;
        transition: transform 0.18s ease;
    }

    .nav-item.open .chev {
        transform: rotate(180deg);
    }

    .nav-menu {
        position: absolute;
        top: calc(100% + 0.85rem);
        left: 50%;
        z-index: 4;
        display: flex;
        flex-direction: column;
        /* Hug the entries so the panel stays within the trigger's footprint. */
        width: max-content;
        padding: 0.5rem;
        border-radius: 18px;
        background: #fff;
        color: #14110f;
        border: 1px solid #e6e3df;
        box-shadow:
            0 1px 2px rgb(20 17 15 / 0.05),
            0 12px 28px -12px rgb(20 17 15 / 0.12);

        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -4px);
        transition:
            opacity 0.16s ease,
            transform 0.16s ease,
            visibility 0.16s;
    }

    .nav-item.open .nav-menu {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
    }

    /* Bridges the gap to the panel so hover survives the cursor crossing it. */
    .nav-menu::before {
        content: "";
        position: absolute;
        inset: -0.85rem 0 100% 0;
    }

    /* Mirrors .nav-link's palette and .btn's pill shape. */
    .nav-menu-link {
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        color: #5f5a55;
        text-decoration: none;
        font-size: 0.845rem;
        white-space: nowrap;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }
    .nav-menu-link:hover {
        background: #f7f6f4;
        color: #14110f;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        justify-self: end;
        gap: 0.4rem;
    }

    .nav-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: #f7f6f4;
        color: #14110f;
        cursor: pointer;
    }
    .nav-toggle:hover {
        background: #e6e3df;
    }

    .nav-toggle-bars,
    .nav-toggle-bars::before,
    .nav-toggle-bars::after {
        display: block;
        width: 0.85rem;
        height: 1.5px;
        border-radius: 1px;
        background: currentColor;
    }

    .nav-toggle-bars {
        position: relative;
    }

    .nav-toggle-bars::before,
    .nav-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        transition:
            transform 0.18s ease,
            top 0.18s ease;
    }

    .nav-toggle-bars::before {
        top: -5px;
    }

    .nav-toggle-bars::after {
        top: 5px;
    }

    .nav.is-open .nav-toggle-bars {
        background: transparent;
    }

    .nav.is-open .nav-toggle-bars::before {
        top: 0;
        transform: rotate(45deg);
    }

    .nav.is-open .nav-toggle-bars::after {
        top: 0;
        transform: rotate(-45deg);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        font-size: 0.845rem;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        padding: 0.45rem 0.85rem;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }

    .btn-ghost {
        color: #14110f;
        background: #f7f6f4;
    }
    .btn-ghost:hover {
        background: #e6e3df;
    }

    .btn-solid {
        color: #fff;
        background: #0000ff;
    }
    .btn-solid:hover {
        background: #0000dd;
    }

    @media (max-width: 720px) {
        .nav-wrap {
            padding-top: 0.85rem;
        }

        .nav {
            position: relative;
            display: flex;
            justify-content: space-between;
            gap: 0.65rem;
            width: 100%;
            padding: 0.4rem 0.4rem 0.4rem 0.95rem;
        }

        .nav-toggle {
            display: inline-flex;
        }

        .nav-links {
            display: none;
            position: absolute;
            top: calc(100% + 0.45rem);
            left: 0;
            right: auto;
            justify-self: stretch;
            box-sizing: border-box;
            width: 100%;
            z-index: 5;
            flex-direction: column;
            align-items: stretch;
            gap: 0.15rem;
            padding: 0.4rem;
            border-radius: 18px;
            background: #fff;
            border: 1px solid #e6e3df;
            box-shadow:
                0 1px 2px rgb(20 17 15 / 0.05),
                0 12px 28px -12px rgb(20 17 15 / 0.12);
        }

        .nav.is-open .nav-links {
            display: flex;
        }

        .nav-link {
            padding: 0.7rem 0.85rem;
            border-radius: 12px;
            font-size: 0.95rem;
        }

        .nav-link:hover {
            background: #f7f6f4;
        }

        .nav-menu {
            position: static;
            width: auto;
            padding: 0 0.35rem 0.25rem;
            border: 0;
            box-shadow: none;
            opacity: 1;
            visibility: visible;
            transform: none;
        }

        .nav-item.open .nav-menu {
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-menu,
        .chev,
        .nav-toggle-bars::before,
        .nav-toggle-bars::after {
            transition: none;
        }
    }
</style>

<script>
    const items = document.querySelectorAll<HTMLElement>(".nav-item.has-menu");

    function close(item: HTMLElement) {
        item.classList.remove("open");
        item.querySelector(".nav-trigger")?.setAttribute(
            "aria-expanded",
            "false",
        );
    }

    function open(item: HTMLElement) {
        items.forEach((other) => other !== item && close(other));
        item.classList.add("open");
        item.querySelector(".nav-trigger")?.setAttribute(
            "aria-expanded",
            "true",
        );
    }

    items.forEach((item) => {
        const trigger = item.querySelector(".nav-trigger");

        // Click drives touch, where hover never fires.
        trigger?.addEventListener("click", () =>
            item.classList.contains("open") ? close(item) : open(item),
        );

        item.addEventListener("mouseenter", () => open(item));
        item.addEventListener("mouseleave", () => close(item));

        // Tabbing past the last entry should dismiss the panel.
        item.addEventListener("focusout", (event) => {
            if (!item.contains(event.relatedTarget as Node)) close(item);
        });
    });

    const nav = document.querySelector<HTMLElement>(".nav");
    const toggle = nav?.querySelector<HTMLButtonElement>(".nav-toggle");

    function setMenu(open: boolean) {
        if (!nav || !toggle) return;
        nav.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }

    if (nav && toggle && nav.dataset.navBound !== "1") {
        nav.dataset.navBound = "1";
        toggle.addEventListener("click", (event) => {
            event.stopPropagation();
            setMenu(!nav.classList.contains("is-open"));
        });

        nav.querySelectorAll(".nav-links a").forEach((link) => {
            link.addEventListener("click", () => setMenu(false));
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                items.forEach(close);
                setMenu(false);
            }
        });

        document.addEventListener("click", (event) => {
            const target = event.target as Node;
            items.forEach((item) => {
                if (!item.contains(target)) close(item);
            });
            if (!nav.contains(target)) setMenu(false);
        });
    }
</script>
