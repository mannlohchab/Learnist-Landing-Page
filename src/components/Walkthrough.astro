---
// Four moves of an engagement, in the order a project meets them.
const steps = [
    {
        num: "01",
        tab: "Scope",
        title: "The work, named",
        body: "A written scope before anyone starts. Sites, apps, support, and automation called out separately.",
        kind: "scope",
    },
    {
        num: "02",
        tab: "Shape",
        title: "The shape before the build",
        body: "Structure, flows, and the edges. You see how it fits together before a line is committed.",
        kind: "shape",
    },
    {
        num: "03",
        tab: "Build",
        title: "You get the thing, not a deck",
        body: "Websites and apps, implemented. The repetitive parts get automated while the build is still open.",
        kind: "build",
    },
    {
        num: "04",
        tab: "Care",
        title: "After launch, someone answers",
        body: "Support with a person on it, and automations that keep running on a schedule.",
        kind: "care",
    },
];
---

<section class="walk" id="walkthrough">
    <header class="walk-head">
        <p class="eyebrow">The work</p>
        <h1 class="walk-title">
            One engagement. Four moves.<br />
            Nothing that gets <em>handed off</em>
        </h1>
        <p class="walk-sub">
            Name the work, agree the shape, build it, then stay for support
            and automation.
        </p>
    </header>

    <div class="walk-stage">
        <div class="tabs" role="tablist" aria-label="Steps in a kmos engagement">
            {
                steps.map((step, i) => (
                    <button
                        class:list={["tab", i === 0 && "is-active"]}
                        role="tab"
                        type="button"
                        id={`walk-tab-${i}`}
                        aria-controls={`walk-panel-${i}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        tabindex={i === 0 ? 0 : -1}
                    >
                        <span class="tab-num">{step.num}</span>
                        <span class="tab-label">{step.tab}</span>
                    </button>
                ))
            }
        </div>

        {
            steps.map((step, i) => (
                <div
                    class:list={["panel", i === 0 && "is-active"]}
                    role="tabpanel"
                    id={`walk-panel-${i}`}
                    aria-labelledby={`walk-tab-${i}`}
                    hidden={i !== 0}
                >
                    <div class="panel-copy">
                        <h2 class="panel-title">{step.title}</h2>
                        <p class="panel-body">{step.body}</p>
                    </div>

                    <figure class="frame">
                        <div class="frame-bar" aria-hidden="true">
                            <span class="dots">
                                <i />
                                <i />
                                <i />
                            </span>
                            <span class="frame-url">kmos.dev</span>
                        </div>
                        <div class="frame-shot">
                            {step.kind === "scope" && (
                                <div class="mock">
                                    <p class="mock-kicker">Engagement</p>
                                    <ul class="mock-rows">
                                        <li><span>01</span><div><strong>Website</strong><p>Marketing site, five pages, ready to edit.</p></div></li>
                                        <li><span>02</span><div><strong>App</strong><p>Internal tool for the job the site can't hold.</p></div></li>
                                        <li><span>03</span><div><strong>Support</strong><p>A person on the system after it is live.</p></div></li>
                                        <li><span>04</span><div><strong>Automation</strong><p>The Monday export, running at 06:00.</p></div></li>
                                    </ul>
                                </div>
                            )}
                            {step.kind === "shape" && (
                                <div class="mock">
                                    <p class="mock-kicker">Shape</p>
                                    <div class="mock-table">
                                        <div><em>Page</em><em>Job</em></div>
                                        <div><span>Home</span><span>Say what kmos does</span></div>
                                        <div><span>Work</span><span>Show the four moves</span></div>
                                        <div><span>Pricing</span><span>Scope before a start</span></div>
                                        <div><span>Inbox</span><span>Where support lands</span></div>
                                    </div>
                                </div>
                            )}
                            {step.kind === "build" && (
                                <div class="mock">
                                    <p class="mock-kicker">Build</p>
                                    <ul class="mock-checks">
                                        <li><i class="ok">✓</i> Site live on the domain</li>
                                        <li><i class="ok">✓</i> App behind the same login</li>
                                        <li><i class="ok">✓</i> Invoice sync scheduled</li>
                                        <li><i class="wait">–</i> Support handoff, this Friday</li>
                                    </ul>
                                </div>
                            )}
                            {step.kind === "care" && (
                                <div class="mock">
                                    <p class="mock-kicker">Care</p>
                                    <ul class="mock-rows">
                                        <li><span class="ok">open</span><div><strong>Checkout timeout</strong><p>Looking now. Rollback is staged.</p></div></li>
                                        <li><span>06:00</span><div><strong>invoice-sync</strong><p>Last run wrote 128 records.</p></div></li>
                                        <li><span class="ok">quiet</span><div><strong>Site</strong><p>No incidents this week.</p></div></li>
                                    </ul>
                                </div>
                            )}
                        </div>
                    </figure>
                </div>
            ))
        }
    </div>

    <div class="walk-cta">
        <a class="btn btn-solid" href="/start">Start a project</a>
        <a class="btn btn-ghost" href="/pricing">See how it's priced</a>
    </div>
</section>

<script>
    // Roving tabindex: one tab in the tab order, arrows move between the rest.
    document.querySelectorAll<HTMLElement>(".walk-stage").forEach((stage) => {
        const tabs = [...stage.querySelectorAll<HTMLButtonElement>(".tab")];
        const panels = [...stage.querySelectorAll<HTMLElement>(".panel")];
        if (!tabs.length) return;

        const select = (next: number, focus = false) => {
            tabs.forEach((tab, i) => {
                const on = i === next;
                tab.classList.toggle("is-active", on);
                tab.setAttribute("aria-selected", String(on));
                tab.tabIndex = on ? 0 : -1;
                panels[i]?.classList.toggle("is-active", on);
                if (panels[i]) panels[i].hidden = !on;
            });
            if (focus) tabs[next].focus();
        };

        tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => select(i));
            tab.addEventListener("keydown", (event) => {
                const step =
                    event.key === "ArrowRight" || event.key === "ArrowDown"
                        ? 1
                        : event.key === "ArrowLeft" || event.key === "ArrowUp"
                          ? -1
                          : 0;
                if (step) {
                    event.preventDefault();
                    select((i + step + tabs.length) % tabs.length, true);
                } else if (event.key === "Home") {
                    event.preventDefault();
                    select(0, true);
                } else if (event.key === "End") {
                    event.preventDefault();
                    select(tabs.length - 1, true);
                }
            });
        });
    });
</script>

<style>
    .walk {
        position: relative;
        z-index: 2;
        padding: 2.5rem 0 4.5rem;
        color: var(--ink);
    }

    /* ---------- Head ---------- */

    .walk-head {
        max-width: 40rem;
    }

    .eyebrow {
        margin: 0 0 0.9rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .walk-title {
        margin: 0;
        font-size: clamp(2rem, 4.8vw, 3.15rem);
        line-height: 1.07;
        letter-spacing: -0.035em;
        font-weight: 650;
    }

    .walk-title em {
        font-family: "Instrument Serif", "Iowan Old Style", Georgia, serif;
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.01em;
    }

    .walk-sub {
        margin: 1rem 0 0;
        font-size: 1rem;
        line-height: 1.55;
        color: var(--muted);
        max-width: 42ch;
        text-wrap: pretty;
    }

    /* ---------- Stage ---------- */

    .walk-stage {
        margin-top: 2.5rem;
    }

    .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tab {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.6rem 1.1rem;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: #fff;
        color: var(--muted);
        font: inherit;
        font-size: 0.9rem;
        font-weight: 550;
        letter-spacing: -0.01em;
        cursor: pointer;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease,
            color 0.15s ease,
            box-shadow 0.15s ease;
    }

    .tab:hover {
        color: var(--ink);
        border-color: #d3cfc9;
    }

    .tab:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .tab-num {
        font-size: 0.7rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        opacity: 0.6;
    }

    .tab.is-active {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
        box-shadow:
            0 1px 2px rgb(0 0 255 / 0.28),
            0 12px 24px -14px rgb(0 0 255 / 0.6);
    }

    .tab.is-active .tab-num {
        opacity: 0.75;
    }

    /* ---------- Panel ---------- */

    .panel {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        align-items: start;
        gap: 1.75rem 2.75rem;
        margin-top: 2rem;
    }

    /* `display: grid` above would otherwise beat the UA's [hidden] rule and
       leave every panel stacked on the page. */
    .panel[hidden] {
        display: none;
    }

    /* Switching tabs replaces the whole panel, so fade it in rather than
       letting the new screenshot snap into place. */
    .panel.is-active {
        animation: panel-in 0.28s ease both;
    }

    @keyframes panel-in {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
    }

    .panel-copy {
        position: sticky;
        top: 2rem;
    }

    .panel-title {
        margin: 0;
        font-size: clamp(1.15rem, 2vw, 1.5rem);
        line-height: 1.2;
        letter-spacing: -0.025em;
        font-weight: 650;
        text-wrap: balance;
    }

    .panel-body {
        margin: 0.6rem 0 0;
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--muted);
        text-wrap: pretty;
    }

    /* ---------- Browser frame ---------- */

    .frame {
        margin: 0;
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        background: #fff;
        overflow: hidden;
        box-shadow:
            0 1px 2px rgb(20 17 15 / 0.05),
            0 24px 48px -32px rgb(20 17 15 / 0.35);
    }

    .frame-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 0.75rem;
        border-bottom: 1px solid var(--rule);
        background: var(--surface);
    }

    .dots {
        display: flex;
        gap: 5px;
    }

    .dots i {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #d6d2cc;
    }

    .frame-url {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.68rem;
        color: #a19b94;
    }

    /* Screenshots are ~750x437 through 1200x699 — same ratio, so one box fits
       all four and tab switches never shift the page. */
    .frame-shot {
        aspect-ratio: 750 / 437;
        background: var(--surface);
    }

    .mock {
        box-sizing: border-box;
        height: 100%;
        padding: 1.15rem 1.2rem 1.25rem;
        background: #f6f5f3;
        color: var(--ink);
    }

    .mock-kicker {
        margin: 0 0 0.85rem;
        font-size: 0.68rem;
        font-weight: 650;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .mock-rows,
    .mock-checks,
    .mock-plain {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .mock-rows {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .mock-rows li {
        display: grid;
        grid-template-columns: 2.6rem minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
        padding: 0.7rem 0.8rem;
        border: 1px solid var(--rule);
        border-radius: 12px;
        background: #fff;
    }

    .mock-rows span {
        font-size: 0.68rem;
        font-weight: 650;
        letter-spacing: 0.04em;
        color: var(--accent);
    }

    .mock-rows strong,
    .mock-checks li {
        font-size: 0.84rem;
        font-weight: 650;
        letter-spacing: -0.015em;
    }

    .mock-rows p {
        margin: 0.15rem 0 0;
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--muted);
    }

    .mock-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.7rem;
        height: calc(100% - 1.6rem);
    }

    .mock-split > div {
        padding: 0.85rem 0.9rem;
        border: 1px solid var(--rule);
        border-radius: 12px;
        background: #fff;
    }

    .mock-label {
        margin: 0 0 0.65rem;
        font-size: 0.72rem;
        font-weight: 650;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .mock-plain li {
        padding: 0.45rem 0;
        border-top: 1px solid var(--rule);
        font-size: 0.86rem;
        font-weight: 550;
    }

    .mock-checks {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .mock-checks li {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.75rem 0.85rem;
        border: 1px solid var(--rule);
        border-radius: 12px;
        background: #fff;
        font-weight: 550;
    }

    .mock-checks i,
    .mock-rows .ok {
        font-style: normal;
        color: #1b7a2e;
    }

    .mock-checks .wait {
        color: #a19b94;
    }

    .mock-table {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--rule);
        border-radius: 12px;
        background: #fff;
    }

    .mock-table > div {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        gap: 0.75rem;
        padding: 0.7rem 0.85rem;
        border-top: 1px solid var(--rule);
        font-size: 0.82rem;
    }

    .mock-table > div:first-child {
        border-top: 0;
        background: var(--surface);
    }

    .mock-table em {
        font-style: normal;
        font-size: 0.68rem;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
    }

    /* ---------- CTA ---------- */

    .walk-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: 3rem;
        padding-top: 2.25rem;
        border-top: 1px solid var(--rule);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.3rem;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 550;
        letter-spacing: -0.005em;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            transform 0.1s ease;
    }

    .btn:active {
        transform: translateY(1px);
    }

    .btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .btn-solid {
        background: var(--accent);
        color: #fff;
        box-shadow:
            0 1px 2px rgb(0 0 255 / 0.28),
            0 12px 24px -12px rgb(0 0 255 / 0.55);
    }

    .btn-solid:hover {
        background: var(--accent-hover);
    }

    .btn-ghost {
        background: #fff;
        color: var(--ink);
        border: 1px solid var(--rule);
        box-shadow: 0 1px 2px rgb(20 17 15 / 0.05);
    }

    .btn-ghost:hover {
        border-color: #d3cfc9;
        box-shadow: 0 2px 6px rgb(20 17 15 / 0.08);
    }

    /* ---------- Responsive ---------- */

    @media (max-width: 860px) {
        .walk {
            padding-bottom: 3.25rem;
        }

        .panel {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.25rem;
        }

        .panel-copy {
            position: static;
        }

        .tab {
            padding: 0.55rem 0.9rem;
            font-size: 0.85rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .panel.is-active {
            animation: none;
        }
    }
</style>
