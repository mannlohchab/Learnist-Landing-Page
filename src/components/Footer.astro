---
const productLinks = [
	{ label: "Why", href: "/#why" },
	{ label: "How", href: "/#how" },
	{ label: "Use Cases", href: "/#use-cases" },
	{ label: "Pricing", href: "/pricing" },
];

const resourceLinks = [
	{ label: "FAQ", href: "/pricing#faq" },
	{ label: "Documentation", href: "#docs" },
	{ label: "Guides", href: "#guides" },
	{ label: "Support", href: "mailto:hello@learnist.dev" },
];

const companyLinks = [
	{ label: "About", href: "#about" },
	{ label: "Contact", href: "mailto:hello@learnist.dev" },
	{ label: "Partners", href: "#partners" },
];
---

<footer class="footer">
	<div class="footer-panel">
		<img
			class="footer-bg"
			src="/footer_background.png"
			alt=""
			width="1600"
			height="600"
			decoding="async"
		/>

		<div class="footer-content">
			<div class="footer-top">
				<div class="footer-brand">
					<a class="footer-logo" href="/">
						<img
							class="footer-mark"
							src="/learnist.webp"
							alt=""
							width="36"
							height="36"
						/>
						<span class="footer-name">Learnist</span>
					</a>
					<p class="footer-desc">
						Learnist helps engineers become the ones AI can't
						replace — byte-sized lessons and labs that run inside
						the editor you already use.
					</p>
				</div>

				<nav class="footer-cols" aria-label="Footer">
					<div class="footer-col">
						<p class="footer-col-title">Product</p>
						<ul class="footer-list">
							{
								productLinks.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="footer-col">
						<p class="footer-col-title">Resources</p>
						<ul class="footer-list">
							{
								resourceLinks.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="footer-col">
						<p class="footer-col-title">Company</p>
						<ul class="footer-list">
							{
								companyLinks.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))
							}
						</ul>
					</div>
				</nav>
			</div>

			<div class="footer-bottom">
				<p class="footer-copy">
					©2026 LEARNIST. All rights reserved.
				</p>
				<div class="footer-legal">
					<a href="#terms">Terms of Service</a>
					<a href="#privacy">Privacy Policy</a>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		z-index: 2;
		padding: 0 0 0;
		color: #f4f2ef;
		font-family:
			"Inter",
			ui-sans-serif,
			system-ui,
			-apple-system,
			"Segoe UI",
			sans-serif;
	}

	.footer-panel {
		position: relative;
		overflow: hidden;
		margin-inline: calc(-1 * var(--shell-pad));
		width: calc(100% + 2 * var(--shell-pad));
		border-radius: 0;
		background: #0d1a14;
		aspect-ratio: 16 / 9;
		isolation: isolate;
	}

	.footer-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		image-rendering: pixelated;
		pointer-events: none;
		user-select: none;
	}

	.footer-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 4rem;
		box-sizing: border-box;
		height: 100%;
		padding: 2.5rem 2.25rem 1.75rem;
	}

	.footer-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 3rem;
	}

	.footer-brand {
		max-width: 17.5rem;
		flex-shrink: 0;
	}

	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: inherit;
		text-decoration: none;
	}

	.footer-mark {
		display: block;
		width: 2rem;
		height: 2rem;
		border-radius: 0.45rem;
		background: #fff;
		object-fit: cover;
	}

	.footer-name {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-shadow: 0 1px 8px rgb(0 20 60 / 0.45);
	}

	.footer-desc {
		margin: 0.9rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.55;
		font-weight: 400;
		color: rgb(244 242 239 / 0.92);
		text-shadow: 0 1px 10px rgb(0 20 60 / 0.55);
	}

	.footer-cols {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem 3.25rem;
	}

	.footer-col-title {
		margin: 0 0 0.85rem;
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-shadow: 0 1px 8px rgb(0 20 60 / 0.45);
	}

	.footer-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.footer-list a {
		font-size: 0.8125rem;
		font-weight: 400;
		color: rgb(244 242 239 / 0.9);
		text-decoration: none;
		text-shadow: 0 1px 8px rgb(0 20 60 / 0.5);
		transition: color 0.15s ease;
	}

	.footer-list a:hover {
		color: #fff;
	}

	.footer-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.footer-copy {
		margin: 0;
		font-size: 0.6875rem;
		letter-spacing: 0.02em;
		color: rgb(244 242 239 / 0.88);
		text-shadow: 0 1px 8px rgb(0 20 60 / 0.55);
	}

	.footer-legal {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem 1.75rem;
	}

	.footer-legal a {
		font-size: 0.75rem;
		color: rgb(244 242 239 / 0.92);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-shadow: 0 1px 8px rgb(0 20 60 / 0.5);
		transition: color 0.15s ease;
	}

	.footer-legal a:hover {
		color: #fff;
	}

	@media (max-width: 760px) {
		.footer-panel {
			aspect-ratio: auto;
			min-height: 26rem;
		}

		.footer-content {
			gap: 2.75rem;
			padding: 1.75rem 1.35rem 1.35rem;
		}

		.footer-top {
			flex-direction: column;
			gap: 2rem;
		}

		.footer-brand {
			max-width: 22rem;
		}

		.footer-cols {
			gap: 1.75rem 2.25rem;
		}

		.footer-bottom {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 1rem;
		}
	}

	@media (max-width: 480px) {
		.footer-cols {
			display: grid;
			grid-template-columns: 1fr 1fr;
			width: 100%;
		}

		.footer-col:last-child {
			grid-column: 1 / -1;
		}
	}
</style>
