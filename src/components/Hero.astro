---
import Bento from "./Bento.astro";
import Footer from "./Footer.astro";
import IsThisForYou from "./IsThisForYou.astro";
import Navbar from "./Navbar.astro";
import SecondSection from "./SecondSection.astro";

// Tools Learnist plugs into. `icon` maps to a file in public/icons.
const worksWith = [
    { name: "Claude", icon: "claude" },
    { name: "Claude Code", icon: "claudecode" },
    { name: "OpenAI", icon: "openai" },
    { name: "GitHub Copilot", icon: "copilot" },
    { name: "Cursor", icon: "cursor" },
    { name: "VS Code", icon: "vscode" },
    { name: "JetBrains", icon: "jetbrains" },
    { name: "Zed", icon: "zed" },
];
---

<div class="page">
    <div class="page-shell">
        <Navbar />

        <section class="hero">
        <div class="hero-media" aria-hidden="true"></div>

        <div class="hero-body">
            <div class="hero-lead">
                <h1 class="headline">
                    Become the engineer <br />
                    AI can't <em>replace</em>
                </h1>

                <div class="trust">
                    <p class="trust-label">Learnist works with all of it.</p>
                    <ul class="trust-logos">
                        {
                            worksWith.map((tool) => (
                                <li>
                                    <img
                                        class="trust-icon"
                                        src={`/icons/${tool.icon}.svg`}
                                        alt={tool.name}
                                        width="24"
                                        height="24"
                                    />
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>

            <div class="hero-aside">
                <p class="subhead">
                    Byte-sized lessons and labs that coach without handing you
                    the answer. Runs inside the AI editor you already use.
                </p>

                <div class="cta">
                    <a class="cta-btn cta-primary" href="#signup"
                        >Get for Lifetime</a
                    >
                    <a class="cta-btn cta-secondary" href="#demo"
                        >See Learnist in action</a
                    >
                </div>
            </div>
        </div>
    </section>

    <SecondSection />
    <Bento />
    <IsThisForYou />
    <Footer />
    </div>
</div>

<style>
    .page {
        --ink: #14110f;
        --muted: #5f5a55;
        --surface: #f7f6f4;
        --rule: #e6e3df;
        --accent: #0000ff;
        --accent-hover: #0000dd;
        --radius: 14px;
        --col-max: 1090px;
        --shell-pad: calc(1.5rem + 2px);

        position: relative;
        min-height: 100%;
        background: var(--surface);
        color: var(--ink);
        font-family:
            "Inter",
            ui-sans-serif,
            system-ui,
            -apple-system,
            "Segoe UI",
            sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .page-shell {
        box-sizing: border-box;
        width: min(var(--col-max), 100%);
        max-width: var(--col-max);
        margin: 0 auto;
        padding: 0 var(--shell-pad);
        border-left: 1px solid var(--rule);
        border-right: 1px solid var(--rule);
        min-height: 100%;
    }

    /* ---------- Hero ---------- */

    .hero {
        position: relative;
        z-index: 2;
        padding: 2.25rem 0 3.5rem;
    }

    .hero-media {
        overflow: hidden;
        border-radius: calc(var(--radius) + 6px);
        border: 1px solid var(--rule);
        box-shadow:
            0 1px 2px rgb(20 17 15 / 0.06),
            0 24px 48px -20px rgb(20 17 15 / 0.28);
        background:
            #0d1a14 url("/hero.gif") center / cover no-repeat;
        aspect-ratio: 16 / 9;
        image-rendering: pixelated;
    }

    .hero-body {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: 2rem 3rem;
        align-items: end;
        margin-top: 2.25rem;
    }

    .headline {
        margin: 0;
        font-size: clamp(2.25rem, 5.4vw, 3.5rem);
        line-height: 1.06;
        letter-spacing: -0.035em;
        font-weight: 650;
    }

    .headline em {
        font-family: "Instrument Serif", "Iowan Old Style", Georgia, serif;
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.01em;
    }

    .trust {
        margin-top: 2.5rem;
    }

    .trust-label {
        margin: 0 0 1rem;
        font-size: 0.9rem;
        color: var(--muted);
    }

    .trust-logos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.15rem 1.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .trust-logos li {
        display: flex;
    }

    .trust-icon {
        display: block;
        width: 1.6rem;
        height: 1.6rem;
        object-fit: contain;
    }

    .hero-aside {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
    }

    .subhead {
        margin: 0;
        font-size: 1.02rem;
        line-height: 1.55;
        color: var(--muted);
        max-width: 34ch;
        text-wrap: pretty;
    }

    .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .cta-btn {
        flex: 1 1 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.3rem;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 550;
        letter-spacing: -0.005em;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            transform 0.1s ease;
    }
    .cta-btn:active {
        transform: translateY(1px);
    }
    .cta-btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .cta-primary {
        background: var(--accent);
        color: #fff;
        box-shadow:
            0 1px 2px rgb(0 0 255 / 0.28),
            0 12px 24px -12px rgb(0 0 255 / 0.55);
    }
    .cta-primary:hover {
        background: var(--accent-hover);
    }

    /* Sits on a near-white surface, so it needs a rule to hold its edge. */
    .cta-secondary {
        background: #fff;
        color: var(--ink);
        border: 1px solid var(--rule);
        box-shadow: 0 1px 2px rgb(20 17 15 / 0.05);
    }
    .cta-secondary:hover {
        border-color: #d3cfc9;
        box-shadow: 0 2px 6px rgb(20 17 15 / 0.08);
    }

    @media (max-width: 860px) {
        .hero-body {
            grid-template-columns: minmax(0, 1fr);
            align-items: start;
            gap: 2.25rem;
        }

        .trust {
            margin-top: 1.75rem;
        }
    }

    @media (max-width: 720px) {
        .hero-media {
            aspect-ratio: 4 / 3;
        }
    }
</style>
