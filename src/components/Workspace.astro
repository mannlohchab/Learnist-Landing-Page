---
// Split intro + a bled-off screenshot panel, in the shape of the reference:
// heading on the left, two capability rows on the right, artwork underneath.
const capabilities = [
    {
        title: "Search the content, not the titles",
        body: "⌘K reaches into lesson bodies — .query() calls, middleware notes, the line you half-remember — across every topic you've touched.",
        icon: "search",
    },
    {
        title: "Progress that looks like work",
        body: "Active days, revises, outcomes met, and a heatmap of when you actually showed up. Not a percentage bar that only goes up.",
        icon: "activity",
    },
];

const shots = [
    // Both sources are full-page 1200x700 captures. Side by side they need
    // help to stay readable: `zoom` pushes past the dead margins each carries
    // (page chrome around the palette, none around the profile stats, which
    // already run edge to edge), and `focus` is the origin it grows from.
    {
        src: "/product/search.webp",
        alt: "Learnist command palette open on a query search, showing matching lines from two tRPC lessons.",
        caption: "Full-text search",
        zoom: 1.5,
        focus: "50% 50%",
    },
    {
        src: "/product/profile.webp",
        alt: "A Learnist profile page showing weekly event counts, a contribution heatmap, and all-time totals.",
        caption: "Your profile",
        zoom: 1,
        focus: "50% 30%",
    },
];
---

<section class="ws" id="workspace">
    <div class="ws-intro">
        <div class="ws-lede">
            <p class="eyebrow">
                <svg
                    class="eyebrow-mark"
                    viewBox="0 0 16 16"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="2" y="2.75" width="12" height="10.5" rx="2"></rect>
                    <path d="M2 6.25h12M5.75 6.25v7"></path>
                </svg>
                The workspace
            </p>
            <h2 class="ws-title">
                Everything you learned,<br />
                still <em>findable</em>
            </h2>
            <p class="ws-sub">
                Lessons don't disappear once you close them. The workspace keeps
                the whole trail — searchable, and honest about the days you
                skipped.
            </p>
        </div>

        <ul class="ws-caps">
            {
                capabilities.map((cap) => (
                    <li class="cap">
                        <span class="cap-icon" aria-hidden="true">
                            {cap.icon === "search" ? (
                                <svg
                                    viewBox="0 0 18 18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                >
                                    <circle cx="8" cy="8" r="5" />
                                    <path d="M11.8 11.8 15.5 15.5" />
                                </svg>
                            ) : (
                                <svg
                                    viewBox="0 0 18 18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M2.5 15.5V9.5M7 15.5V4.5M11.5 15.5v-8M16 15.5v-11" />
                                </svg>
                            )}
                        </span>
                        <div class="cap-text">
                            <h3>{cap.title}</h3>
                            <p>{cap.body}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>

    <div class="ws-stage">
        <div class="ws-shots">
            {
                shots.map((shot) => (
                    <figure class="shot">
                        <div class="shot-bar" aria-hidden="true">
                            <span class="dots">
                                <i />
                                <i />
                                <i />
                            </span>
                            <span class="shot-caption">{shot.caption}</span>
                        </div>
                        <div
                            class="shot-crop"
                            style={`--zoom:${shot.zoom};--focus:${shot.focus}`}
                        >
                            <img
                                src={shot.src}
                                alt={shot.alt}
                                width="1200"
                                height="700"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    </figure>
                ))
            }
        </div>
    </div>
</section>

<style>
    .ws {
        position: relative;
        z-index: 2;
        padding: 1.5rem 0 4.5rem;
        color: var(--ink);
    }

    /* ---------- Intro ---------- */

    .ws-intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: start;
        gap: 2rem 3.5rem;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin: 0 0 1rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .eyebrow-mark {
        width: 0.95rem;
        height: 0.95rem;
    }

    .ws-title {
        margin: 0;
        font-size: clamp(1.9rem, 4vw, 2.85rem);
        line-height: 1.08;
        letter-spacing: -0.035em;
        font-weight: 700;
    }

    .ws-title em {
        font-family: "Instrument Serif", "Iowan Old Style", Georgia, serif;
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.01em;
    }

    .ws-sub {
        margin: 1rem 0 0;
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--muted);
        max-width: 34ch;
        text-wrap: pretty;
    }

    /* ---------- Capability rows ---------- */

    .ws-caps {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        margin: 0.35rem 0 0;
        padding: 0;
        list-style: none;
    }

    .cap {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
    }

    .cap-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--rule);
        border-radius: 10px;
        background: #fff;
        color: var(--accent);
        box-shadow: 0 1px 2px rgb(20 17 15 / 0.05);
    }

    .cap-icon svg {
        width: 1.05rem;
        height: 1.05rem;
    }

    .cap-text h3 {
        margin: 0.3rem 0 0;
        font-size: 1rem;
        font-weight: 650;
        letter-spacing: -0.02em;
    }

    .cap-text p {
        margin: 0.4rem 0 0;
        font-size: 0.875rem;
        line-height: 1.55;
        color: var(--muted);
        text-wrap: pretty;
    }

    /* ---------- Artwork panel ----------
       Screenshots run off the bottom edge, as in the reference, so the panel
       reads as a window onto the app rather than a framed pair of images.
       The wash is the hero's blue at low opacity — the sky photo used
       elsewhere is far too saturated behind white cards. */

    .ws-stage {
        /* The page has no global box-sizing reset, so this must be explicit —
           otherwise padding and border push the panel past the shell rules. */
        box-sizing: border-box;
        margin-top: 2.75rem;
        padding: 1.5rem 1.5rem 0;
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        overflow: hidden;
        background:
            radial-gradient(
                ellipse 90% 70% at 50% 110%,
                rgb(0 0 255 / 0.1),
                transparent 70%
            ),
            linear-gradient(180deg, rgb(0 0 255 / 0.05), rgb(0 0 255 / 0.02)),
            #fff;
    }

    .ws-shots {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
        align-items: start;
    }

    /* The crop is the window; the image grows inside it so the UI lands near
       native scale instead of a whole page shrunk into half a column. */
    .shot-crop {
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: var(--surface);
    }

    .shot-crop img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--focus, center);
        transform: scale(var(--zoom, 1));
        transform-origin: var(--focus, center);
    }

    .shot {
        margin: 0;
        border: 1px solid rgb(255 255 255 / 0.5);
        border-radius: 12px;
        background: #fff;
        overflow: hidden;
        box-shadow:
            0 1px 2px rgb(20 17 15 / 0.06),
            0 30px 60px -30px rgb(20 17 15 / 0.45);
    }

    .shot-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.7rem;
        border-bottom: 1px solid var(--rule);
        background: var(--surface);
    }

    .dots {
        display: flex;
        gap: 5px;
    }

    .dots i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d6d2cc;
    }

    .shot-caption {
        font-size: 0.68rem;
        font-weight: 550;
        letter-spacing: -0.005em;
        color: #a19b94;
    }

    .shot img {
        display: block;
    }

    /* ---------- Responsive ---------- */

    @media (max-width: 860px) {
        .ws {
            padding-bottom: 3.25rem;
        }

        .ws-intro {
            grid-template-columns: minmax(0, 1fr);
            gap: 2rem;
        }

        .ws-sub {
            max-width: none;
        }

        .ws-stage {
            margin-top: 2rem;
            padding: 1rem 1rem 0;
        }

        .ws-shots {
            grid-template-columns: minmax(0, 1fr);
            gap: 1rem;
        }
    }
</style>
