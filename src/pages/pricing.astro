---
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Pricing from "../components/Pricing.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pricing — Learnist">
	<div class="page">
		<div class="page-shell">
			<Navbar />
			<Pricing />
			<Faq />
			<Footer />
		</div>
	</div>
</Layout>

<style>
	.page {
		--ink: #14110f;
		--muted: #5f5a55;
		--surface: #f7f6f4;
		--rule: #e6e3df;
		--accent: #0000ff;
		--accent-hover: #0000dd;
		--radius: 14px;
		--col-max: 1090px;
		--shell-pad: calc(1.5rem + 2px);

		position: relative;
		min-height: 100%;
		background:
			radial-gradient(
				ellipse 80% 50% at 50% -10%,
				rgb(0 0 255 / 0.06),
				transparent 55%
			),
			var(--surface);
		color: var(--ink);
		font-family:
			"Inter",
			ui-sans-serif,
			system-ui,
			-apple-system,
			"Segoe UI",
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	.page-shell {
		box-sizing: border-box;
		width: min(var(--col-max), 100%);
		max-width: var(--col-max);
		margin: 0 auto;
		padding: 0 var(--shell-pad);
		border-left: 1px solid var(--rule);
		border-right: 1px solid var(--rule);
		min-height: 100%;
	}
</style>
