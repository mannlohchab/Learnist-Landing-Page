---
export const prerender = false;

import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";

const error = Astro.url.searchParams.get("error");
const sent = Astro.url.searchParams.get("sent") === "1";

const errorCopy =
	error === "phone"
		? "Enter a phone number we can call, including the country code if you have one."
		: error === "query"
			? "Write what went wrong. It can be a sentence or a few paragraphs."
			: error === "save"
				? "That didn't save. Try again, or email kmos.support@gmail.com."
				: "";
---

<Layout title="Grievance — kmos">
	<div class="page">
		<div class="page-shell">
			<Navbar />
			<main class="start">
				<header class="start-head">
					<p class="start-tag">Grievance</p>
					<h1>Tell us what went wrong.</h1>
					<p class="start-lead">
						A number and what happened is enough. We'll read it and
						get back to you.
					</p>
				</header>

				{
					sent ? (
						<p class="banner banner-ok" role="status">
							Got it. We'll look into this and get back to you.
						</p>
					) : null
				}
				{
					errorCopy ? (
						<p class="banner banner-bad" role="alert">
							{errorCopy}
						</p>
					) : null
				}

				<form class="card" method="post" action="/api/inquiries">
					<input type="hidden" name="kind" value="grievance" />
					<label>
						<span>Phone number</span>
						<input
							type="tel"
							name="phone"
							inputmode="tel"
							autocomplete="tel"
							required
							maxlength="24"
							placeholder="+91 98765 43210"
						/>
					</label>
					<label>
						<span>Query</span>
						<textarea
							name="query"
							required
							rows="6"
							maxlength="2000"
							placeholder="What happened, and what should we make right?"
						></textarea>
					</label>
					<button type="submit">Send grievance</button>
					<p class="aside">
						Or email
						<a href="mailto:kmos.support@gmail.com"
							>kmos.support@gmail.com</a
						>. Starting something new?
						<a href="/start">Start a project</a>.
					</p>
				</form>
			</main>
			<Footer />
		</div>
	</div>
</Layout>

<style>
	.page {
		--ink: #14110f;
		--muted: #5f5a55;
		--surface: #f7f6f4;
		--rule: #e6e3df;
		--accent: #0000ff;
		--accent-hover: #0000dd;
		--radius: 14px;
		--col-max: 1090px;
		--shell-pad: calc(1.5rem + 2px);

		position: relative;
		min-height: 100%;
		background:
			radial-gradient(
				ellipse 80% 50% at 50% -10%,
				rgb(0 0 255 / 0.06),
				transparent 55%
			),
			var(--surface);
		color: var(--ink);
		font-family:
			"Inter",
			ui-sans-serif,
			system-ui,
			-apple-system,
			"Segoe UI",
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	.page-shell {
		box-sizing: border-box;
		width: min(var(--col-max), 100%);
		max-width: var(--col-max);
		margin: 0 auto;
		padding: 0 var(--shell-pad);
		border-left: 1px solid var(--rule);
		border-right: 1px solid var(--rule);
		min-height: 100%;
	}

	.start {
		padding: 2.75rem 0 3.5rem;
	}

	.start-head {
		max-width: 34rem;
		margin: 0 auto 1.75rem;
		text-align: center;
	}

	.start-tag {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.start h1 {
		margin: 0.65rem 0 0;
		font-size: clamp(1.85rem, 4vw, 2.6rem);
		line-height: 1.08;
		letter-spacing: -0.035em;
		font-weight: 650;
	}

	.start-lead {
		margin: 0.85rem 0 0;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.banner {
		max-width: 32rem;
		margin: 0 auto 1rem;
		padding: 0.85rem 1rem;
		border-radius: 12px;
		font-size: 0.92rem;
		line-height: 1.45;
	}

	.banner-ok {
		background: #eef8f1;
		border: 1px solid #b7dfc4;
		color: #1b7a3a;
	}

	.banner-bad {
		background: #fff;
		border: 1px solid #e7c1c8;
		color: #7a2434;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 32rem;
		margin: 0 auto;
		padding: 1.35rem;
		border: 1px solid var(--rule);
		border-radius: 22px;
		background: #fff;
		box-shadow:
			0 1px 2px rgb(20 17 15 / 0.05),
			0 24px 48px -28px rgb(20 17 15 / 0.28);
	}

	label {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	label span {
		font-size: 0.82rem;
		font-weight: 650;
		letter-spacing: -0.01em;
	}

	input,
	textarea {
		box-sizing: border-box;
		width: 100%;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--rule);
		border-radius: 12px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 0.95rem;
		line-height: 1.45;
	}

	textarea {
		resize: vertical;
		min-height: 8rem;
	}

	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	button {
		margin-top: 0.25rem;
		min-height: 2.75rem;
		border: 0;
		border-radius: 12px;
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-size: 0.92rem;
		font-weight: 550;
		cursor: pointer;
		box-shadow:
			0 1px 2px rgb(0 0 255 / 0.28),
			0 12px 24px -12px rgb(0 0 255 / 0.55);
	}

	button:hover {
		background: var(--accent-hover);
	}

	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.aside {
		margin: 0;
		font-size: 0.82rem;
		color: var(--muted);
		text-align: center;
	}

	.aside a {
		color: var(--ink);
	}

	@media (max-width: 860px) {
		.start {
			padding: 1.75rem 0 2.75rem;
		}

		.start-head {
			text-align: left;
		}
	}
</style>
